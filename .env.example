# LLM Configuration (choose one):
# Option 1: Browser Use API Key - Get from https://cloud.browser-use.com/new-api-key
BROWSER_USE_API_KEY=your-browser-use-api-key-here

# Option 2: OpenAI-compatible API (if not using Browser Use Cloud LLM)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: set custom base URL for OpenAI-compatible APIs
# OPENAI_MODEL=gpt-4  # Optional: default is gpt-4

# Browser Configuration (optional - for using existing browser):
# CHROME_CDP_URL=http://localhost:9222  # Connect to existing Chrome with remote debugging
# CHROME_USER_DATA_DIR=/path/to/chrome/profile  # Use persistent Chrome profile

# Duolingo Credentials
DUOLINGO_USERNAME=your-duolingo-username
DUOLINGO_PASSWORD=your-duolingo-password
